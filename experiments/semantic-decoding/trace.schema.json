{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ik-llama.local/semantic-decoding/trace-record.schema.json",
  "title": "Semantic Decoding NDJSON Record",
  "description": "Schema for one line of IK_LLAMA_SPEC_TRACE NDJSON output.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "outcome",
    "seq_id",
    "n_past",
    "proposer",
    "proposed_tokens",
    "accepted_tokens",
    "rejected_at",
    "verification_total_us",
    "used_speculative",
    "failed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "type": { "const": "speculation" },
    "outcome": {
      "enum": [
        "attempt",
        "no_proposal",
        "below_min_draft",
        "checkpoint_unavailable",
        "proposal_invalid",
        "verify_failed",
        "sampling_failed",
        "partial_accept",
        "full_accept"
      ]
    },
    "seq_id": { "type": "integer" },
    "n_past": { "type": "integer", "minimum": 0 },
    "proposer": { "type": "string" },
    "proposed_tokens": { "type": "integer", "minimum": 0 },
    "accepted_tokens": { "type": "integer", "minimum": 0 },
    "rejected_at": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "verification_total_us": { "type": "integer", "minimum": 0 },
    "used_speculative": { "type": "boolean" },
    "failed": { "type": "boolean" }
  },
  "additionalProperties": true
}
